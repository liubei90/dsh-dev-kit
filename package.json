{
  "name": "dsh-dev-kit",
  "version": "0.1.0",
  "private": true,
  "dshDevKit": { "version": 1 },
  "description": "AI-agent-first full-stack TypeScript monorepo template (pnpm workspaces), migrating the DeepSeek Harness development system: layered AGENTS.md + Agent Notes + skills + mechanical gates",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "build": "pnpm run build:artifacts && pnpm run build:check",
    "build:artifacts": "tsc -b apps/api apps/web packages/shared",
    "build:check": "tsx scripts/check-built-exports.ts && tsc -p tsconfig.artifacts.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsx scripts/run-oxlint.ts .",
    "lint:fix": "tsx scripts/run-oxlint.ts . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:affected": "tsx scripts/run-affected-tests.ts",
    "doc-sync": "tsx scripts/run-gates.ts doc-sync",
    "check:all": "tsx scripts/run-gates.ts check-all",
    "change-scope": "tsx scripts/change-scope.ts",
    "verify-md-links": "tsx scripts/verify-md-links.ts",
    "verify-md-wrap": "tsx scripts/verify-md-wrap.ts",
    "verify-doc-budgets": "tsx scripts/verify-doc-budgets.ts",
    "verify-agent-note-classification": "tsx scripts/verify-agent-note-classification.ts",
    "verify-agent-note-format": "tsx scripts/verify-agent-note-format.ts",
    "verify-archived-agent-notes": "tsx scripts/verify-archived-agent-notes.ts",
    "verify-skill-invocation-metadata": "tsx scripts/verify-skill-invocation-metadata.ts",
    "postinstall": "node scripts/install-lefthook.mjs"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint-plugin-sonarjs": "^4.2.0",
    "js-yaml": "^4.3.2",
    "lefthook": "^2.1.12",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.11"
  }
}
