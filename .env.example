# API 服务
# 监听端口(缺省 3000)。
PORT=3000
# SQLite 文件路径;仅测试用 ':memory:'。缺省 apps/api/data/dev.sqlite(已 gitignore)。
DATABASE_PATH=
# 必填:签发 auth JWT 的 HS256 密钥。生成示例:openssl rand -hex 32
JWT_SECRET=
# access token 有效期,直接传给 jsonwebtoken(缺省 1h)。
JWT_TTL=1h

# Web 开发代理目标(缺省 http://localhost:3000)。
VITE_API_PROXY_URL=http://localhost:3000
